{
  "name": "foundation-repo-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/build-dashboard.test.js",
    "format": "prettier --write \".github/**/*.yml\" \"*.json\" \"*.md\" \"src/**/*.ts\"",
    "format:check": "prettier --check \".github/**/*.yml\" \"*.json\" \"*.md\" \"src/**/*.ts\""
  },
  "dependencies": {
    "minimatch": "^11.0.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
